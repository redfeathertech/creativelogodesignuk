# Copy to `.env.local` and fill in. NEVER commit real credentials.

# ---- site ------------------------------------------------------------------
# Drives metadataBase, canonicals, sitemap and JSON-LD @ids.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://creativelogodesign.co.uk

# ---- SMTP ------------------------------------------------------------------
# Both forms send two emails per submission: a notification to the team and a
# confirmation to the person who submitted. Without these the payload is logged
# to the server console instead — submissions are never lost, but nothing sends.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Envelope sender. Must be a domain you are authorised to send as, or the mail
# will land in spam.
SMTP_FROM="Creative Logo Design <support@creativelogodesign.co.uk>"
# Where team notifications go. Defaults to the support address.
LEAD_NOTIFY_TO=support@creativelogodesign.co.uk

# ---- reCAPTCHA v3 ----------------------------------------------------------
# v3 keys, NOT v2 — they are not interchangeable, and a v2 secret answering a
# v3 request comes back with no score, which the server rejects outright rather
# than waving through.
# Site key is public; secret key is server-side only.
# When the secret is unset, captcha verification is SKIPPED — fine locally,
# never in production. The server logs an error if it is missing in prod.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# v3 scores 0.0 (bot) to 1.0 (human) instead of passing or failing. Anything
# below this is rejected. Google's default is 0.5; lower it if real enquiries
# start getting turned away, and watch the [recaptcha] score warnings in the
# server log to pick the number.
RECAPTCHA_MIN_SCORE=0.5

# ---- analytics -------------------------------------------------------------
# GA4 measurement ID, e.g. G-XXXXXXXXXX. Omit to disable analytics entirely.
# The live Laravel site has no analytics at all.
NEXT_PUBLIC_GA_ID=

# ---- Chatra live chat --------------------------------------------------------
# Ported from the live Laravel site. Omit to disable the widget entirely.
NEXT_PUBLIC_CHATRA_ID=eyAh3JkMfFQgfPTBQ
