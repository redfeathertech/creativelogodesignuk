# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Matches the Next.js / Prettier defaults every file in this repo already uses.
# (The original 4-space/CRLF settings were carried over from the Laravel repo
# and matched nothing here.)
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false
